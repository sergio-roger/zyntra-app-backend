PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Conexiones de Base de Datos y Servicios
DATABASE_URL=postgresql://user:password@localhost:5432/zyntra_marketing_db
MONGO_URI=mongodb://localhost:27017/marketing_db
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# Rate limit for POST /chat/chat (see src/modules/chatbot/README.md)
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_SEC=60

# Seguridad y Sesiones
SESSION_SECRET=your-secret-key-here
JWT_SECRET=your-jwt-secret-here
ARGON2_PEPPER=your-argon2-pepper-key-here
COOKIE_NAME=planchat_session

# JWT de sesión del widget público (public_key exchange) — secret propio,
# distinto de JWT_SECRET y de SERVICE_TOKEN
WIDGET_SESSION_JWT_SECRET=your-widget-session-jwt-secret-here

# Secreto compartido para /internal/* (hoy: POST /internal/agent-callback,
# validado via header x-service-token). Usado por agent-service (Python) y,
# desde la Fase C, por marketing-agents (Mastra) — debe ser idéntico en ambos.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_TOKEN=your_service_token_here

# API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Storage Service Configuration
STORAGE_SERVICE_URL=http://localhost:3100
STORAGE_SERVICE_TOKEN=your_storage_service_token_here

# Encriptar configuraciones de canales
CHANNEL_CREDENTIALS_KEY=your_channel_credentials_key_here

# AES-256-GCM key for message content at rest (messaging.messages.content_encrypted).
# Separate from CHANNEL_CREDENTIALS_KEY — different data domain, own rotation.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESSAGE_ENCRYPTION_KEY=f3606296a578e294c8ab668c687a6fd7d6c10cc6351e53dc5a905d79391cdecd

# URLs públicas (con default en código si se omiten)
WIDGET_CDN_URL=https://cdn.zyntra.app/widget/v1.js
BACKEND_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
