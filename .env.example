# Puerto en el que corre el backend
PORT=3000

# Entorno de ejecución: development, staging, production
NODE_ENV=development

# Nivel de logs: debug, info, warn, error
LOG_LEVEL=debug

# PostgreSQL: base de datos principal de Zyntra (usuarios, CRM, canales, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/zyntra_marketing_db

# Redis: cache, sesiones, rate limiting, colas de jobs
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Qdrant: vector database para embeddings y RAG
QDRANT_URL=http://localhost:6333

# Rate limit para POST /chat/chat: máximo 20 requests por 60 segundos
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_SEC=60

# Secret para firmar sesiones (express-session)
SESSION_SECRET=your-secret-key-here

# Secret para firmar JWT de autenticación de usuarios
JWT_SECRET=your-jwt-secret-here

# Pepper para hashing de passwords con Argon2
ARGON2_PEPPER=your-argon2-pepper-key-here

# Nombre de la cookie de sesión
COOKIE_NAME=planchat_session

# Secret para JWT de sesiones de widget público (distinto de JWT_SECRET)
WIDGET_SESSION_JWT_SECRET=your-widget-session-jwt-secret-here

# Token de auth entre backend e marketing-agents (sincronizar con .env de ambos)
SERVICE_TOKEN=your_service_token_here

# API key OpenRouter: LLM models para features de backend
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Zyntra Storage: microservicio de almacenamiento de archivos
STORAGE_SERVICE_URL=http://localhost:3100

# Token de auth para Storage Service
STORAGE_SERVICE_TOKEN=your_storage_service_token_here

# Marketing Agents (Mastra): retrieval RAG para "Probar agente"
MARKETING_AGENTS_URL=http://localhost:4111

# Clave para encriptar/desencriptar credenciales de canales en base de datos
CHANNEL_CREDENTIALS_KEY=your_channel_credentials_key_here

# Clave AES-256-GCM para encriptar/desencriptar contenido de mensajes en BD (separada de CHANNEL_CREDENTIALS_KEY)
MESSAGE_ENCRYPTION_KEY=f3606296a578e294c8ab668c687a6fd7d6c10cc6351e53dc5a905d79391cdecd

# URL pública del widget JavaScript en CDN
WIDGET_CDN_URL=https://cdn.zyntra.app/widget/v1.js

# URL pública del backend (usada en widgets, webhooks, etc.)
BACKEND_PUBLIC_URL=http://localhost:3000

# URL pública del frontend (usado en redirects, CORS, etc.)
FRONTEND_URL=http://localhost:5173
